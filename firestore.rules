rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDateKey(id) {
      return id.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function instructorLeaderboardConfigData() {
      return exists(/databases/$(database)/documents/instructorLeaderboardConfig/settings)
        ? get(/databases/$(database)/documents/instructorLeaderboardConfig/settings).data
        : {};
    }

    function instructorSubmissionsOpen() {
      // Dot-access on a map errors out (=> deny) if the key is absent, e.g. before the
      // config doc is ever created — use get() with a default so "open" is the default state.
      return instructorLeaderboardConfigData().get('submissionsOpen', true) != false;
    }

    function instructorVotingOpen() {
      return instructorLeaderboardConfigData().get('votingOpen', false) == true;
    }

    function isValidInstructorNomination(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.nameKey is string && data.nameKey.size() > 0 && data.nameKey.size() <= 80
        && data.link is string && data.link.size() <= 200
        && data.note is string && data.note.size() <= 300
        && data.firstSubmittedAtIso is string
        && data.lastSubmittedAtIso is string;
    }

    function isFeatureFeedbackResponse(data) {
      return data.source == 'hidden_visual_feed'
        && data.submitted == true
        && data.hasSubmittedFeatureFeedback == true
        && isDateKey(data.appDateKey)
        && data.selectedFeatureIds is list
        && data.selectedFeatureIds.size() <= 10
        && data.selectedFeatureLabels is list
        && data.selectedFeatureLabels.size() <= 10
        && data.note is string
        && data.note.size() <= 600
        && data.featureCount is int
        && data.featureCount <= 20;
    }

    match /quilts/{dateKey} {
      allow read: if true;
      // Prevent stale browser/client bundles from clearing production quilts.
      // Admin SDK/server resets bypass Firestore rules, so scheduled resets still work.
      allow create, update: if request.resource.data.blocks is list
        && request.resource.data.blocks.size() > 0;
      allow delete: if false;
    }

    match /quiltNames/{dateKey} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if true;
      // Date-shaped quote docs are daily state and must not be overwritten by stale clients.
      // Server/Admin SDK maintenance bypasses rules; non-date catalog quote docs keep prior behavior.
      allow create, update, delete: if !isDateKey(quoteId);
    }

    match /dailyQuoteAssignments/{dateKey} {
      // Public daily quote state, written only by server/Admin SDK sync jobs.
      allow read: if true;
      allow write: if false;
    }

    match /dailyQuoteUsage/{dateKey} {
      // Public read-only usage metadata for app display; server/Admin SDK writes.
      allow read: if true;
      allow write: if false;
    }

    match /seamsideEpisodes/{artistSlug} {
      // SEAMSIDE guest → episode map for in-app podcast widget.
      allow read: if true;
      allow write: if false;
    }

    match /archives/{dateKey} {
      // Public archive content, written only by server/Admin SDK reset/backfill jobs.
      allow read: if true;
      allow write: if false;
    }

    match /instagram-images/{dateKey} {
      allow read: if true;
      // The app's image pipeline signs in anonymously before uploading Storage assets
      // and merging URL fields here. Server/Admin SDK writes bypass these rules.
      allow create, update: if isSignedIn() && isDateKey(dateKey);
      allow delete: if false;
    }

    match /reflectionResponses/{responseId} {
      // Private raw user reflections: server/Admin SDK writes only.
      allow read, write: if false;
    }

    match /reflectionThemes/{dateKey} {
      allow read: if true;
      // Public generated themes, written only by the server/Admin SDK.
      allow write: if false;
    }

    match /socialPosts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /socialPosts/{postId}/comments/{commentId} {
      allow read: if true;
      allow write: if false;
    }

    match /colorMilestoneNotifications/{notificationId} {
      // Best-effort client analytics. Never required for core quilt saving.
      allow create, update: if true;
      allow read, delete: if false;
    }

    match /featureFeedbackResponses/{responseId} {
      // Hidden visual survey responses. The UI gathers anonymous/device identifiers
      // for follow-up targeting, but only this narrow survey payload can be written.
      allow create, update: if isFeatureFeedbackResponse(request.resource.data);
      allow delete: if false;
    }

    match /popularColorResponses/{dateKey}/responses/{responseId} {
      // Disabled in the current UI, but keep the narrow write path explicit.
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /pushTokens/{tokenId} {
      // Push tokens are registered through the Express API.
      allow read, write: if false;
    }

    match /adminTuneReminders/{dateKey} {
      // One admin-only UI reminder completion marker, shared across devices.
      allow read: if true;
      allow create, update: if isSignedIn()
        && isDateKey(dateKey)
        && request.resource.data.completed == true;
      allow delete: if false;
    }

    match /adminDailyTasks/{dateKey} {
      // Shared admin-only UI checklist state for the daily private reminder.
      allow read: if true;
      allow create, update: if isSignedIn() && isDateKey(dateKey);
      allow delete: if false;
    }

    match /ops/{opId} {
      // Operational idempotency/status docs are server/Admin SDK only.
      allow read, write: if false;
    }

    match /quoteSubmissions/{submissionId} {
      // Quote submissions are created through the Express API.
      allow read, write: if false;
    }

    match /instructorNominations/{nominationId} {
      // NOOK instructor nomination page (standalone, client-writes-directly-to-Firestore;
      // no Express server involved). Doc id is a client-computed hash of the lowercased name.
      allow read: if true;

      allow create: if instructorSubmissionsOpen()
        && isValidInstructorNomination(request.resource.data)
        && request.resource.data.submissionCount == 1;

      // Re-suggesting an existing name: only submissionCount/lastSubmittedAtIso/link/note may
      // change. name/nameKey are immutable and votes live only in the votes/ subcollection.
      allow update: if instructorSubmissionsOpen()
        && isValidInstructorNomination(request.resource.data)
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameKey == resource.data.nameKey
        && request.resource.data.submissionCount == resource.data.submissionCount + 1;

      // No sign-in on this page, so "yours" is a client-side notion (same hashed local
      // client id used for votes) — this cannot verify the deleter actually owns the
      // submission. The client only shows delete/edit controls for a device's own
      // submitter doc; this rule just keeps deletes possible while submissions are open.
      allow delete: if instructorSubmissionsOpen();

      match /votes/{voterId} {
        // One doc per device (voterId = hashed local client id); presence = "has voted".
        // Vote tallies are derived by counting this subcollection, not stored as a counter.
        allow read: if true;
        allow create: if instructorVotingOpen()
          && request.resource.data.keys().hasOnly(['createdAtIso'])
          && request.resource.data.createdAtIso is string;
        allow update: if false;
        allow delete: if instructorVotingOpen();
      }

      match /submitters/{submitterId} {
        // One doc per device that has submitted this instructor (submitterId = hashed
        // local client id). Lets the submit page show "Edit"/"Delete" for a device's own
        // suggestions and lets a solo submitter's delete also remove the parent doc.
        allow read: if true;
        allow create, update: if instructorSubmissionsOpen()
          && request.resource.data.keys().hasOnly(['link', 'note', 'submittedAtIso'])
          && request.resource.data.link is string && request.resource.data.link.size() <= 200
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.submittedAtIso is string;
        allow delete: if instructorSubmissionsOpen();
      }
    }

    match /instructorLeaderboardConfig/{configId} {
      // submissionsOpen / votingOpen flags. Also editable via the Firebase console.
      // No sign-in on this page, so this is passcode-gated in the UI only, same
      // honor-system model as the rest of this feature (see instructorNominations) —
      // reviewed and accepted for this use case rather than adding server-side rate
      // limiting, since the worst case is someone flipping a toggle, not a data leak.
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['submissionsOpen', 'votingOpen', 'updatedAtIso'])
        && request.resource.data.submissionsOpen is bool
        && request.resource.data.votingOpen is bool
        && request.resource.data.updatedAtIso is string;
    }

    match /{collection}/{document=**} {
      // Hotfix: the monolith still has a few startup reads that are easy to miss.
      // Keep unknown client writes closed, but allow public reads outside private/server-only collections.
      allow read: if collection != 'reflectionResponses'
        && collection != 'pushTokens'
        && collection != 'ops'
        && collection != 'quoteSubmissions'
        && collection != 'colorMilestoneNotifications'
        && collection != 'popularColorResponses'
        && collection != 'socialPosts';
      allow write: if false;
    }
  }
}
